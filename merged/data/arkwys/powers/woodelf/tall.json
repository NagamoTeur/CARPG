{
	"type": "origins:action_on_callback",
	"entity_action_added": {
		"type": "origins:and",
		"actions": [
			{
				"type": "origins:execute_command",
				"permission_level": 4,
				"command": "scale set pehkui:base 1.2"
			}
		]
	},
	"entity_action_lost": {
		"type": "origins:and",
		"actions": [
			{
				"type": "origins:execute_command",
				"permission_level": 4,
				"command": "scale reset pehkui:base"
			},
			{
				"type": "origins:execute_command",
				"permission_level": 4,
				"command": "scale persist reset pehkui:base true @s"
			},
			{
				"type": "origins:execute_command",
				"permission_level": 4,
				"command": "scale reset pehkui:motion"
			}
		]
	},
	"entity_action_chosen": {
		"type": "origins:and",
		"actions": [
			{
				"type": "origins:execute_command",
				"permission_level": 4,
				"command": "scale set pehkui:base 1.2"
			}
		]
	},
	"execute_chosen_when_orb": true
}