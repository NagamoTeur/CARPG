{
    "name": "Greater Boon of Gale",
    "description": "Upon slaying the ender dragon,Zephyrus grants you winged flight. Flap your wings by pressing (default key (h).",
    "type": "origins:multiple",
    "condition": {
        "type": "origins:advancement",
        "advancement": "minecraft:end/kill_dragon"
    },
    "elytra": {
        "condition": {
            "type": "origins:advancement",
            "advancement": "minecraft:end/kill_dragon"
        },
        "type": "origins:elytra_flight",
        "render_elytra": true,
        "texture_location": "minecraft:textures/entity/elytra.png"
    },
    "flap": {
        "condition": {
